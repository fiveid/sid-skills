#!/usr/bin/env bash
# Scan staged changes for secrets before they reach history. CI runs the same pinned
# scanner, so this is a convenience, not the guard: `git commit --no-verify` skips it.
#
# Turn it on once per clone:   git config core.hooksPath .githooks

set -uo pipefail
root=$(git rev-parse --show-toplevel) || exit 1
scanner="$root/.tools/bin/betterleaks"

if [ ! -x "$scanner" ]; then
  echo "pre-commit: secret scanner not installed. Run scripts/install-tools.sh, or commit with --no-verify." >&2
  exit 1
fi

"$scanner" git --staged --no-banner --redact --verbose "$root"
